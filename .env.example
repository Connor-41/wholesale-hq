# ── Anthropic (Claude) ───────────────────────────────────────────────────────
# Get yours at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Zapier Outbound Webhook (Zap #2) ─────────────────────────────────────────
# Create Zap #2 in Zapier:
#   Trigger: Webhooks by Zapier → Catch Hook
#   Action:  SmarterContact → Send Message
#     Map these fields from the webhook payload:
#       contact_id or contact_phone → the contact to message
#       message                     → the text to send
# Paste the Catch Hook URL Zapier gives you here:
ZAPIER_OUTBOUND_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/XXXXXXX/XXXXXXX/

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001

# ─────────────────────────────────────────────────────────────────────────────
# ZAP #1 SETUP (no env var needed — configured in Zapier):
#   Trigger: SmarterContact → New Reply
#   Action:  Webhooks by Zapier → POST
#     URL:         https://your-ngrok-url.ngrok.io/webhook/smartercontact
#     Payload type: JSON
#     (Zapier automatically passes through SmarterContact contact fields)
# ─────────────────────────────────────────────────────────────────────────────
