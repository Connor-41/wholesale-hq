# ── Anthropic (Claude) ──────────────────────────────────────────────────────
# Get yours at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── SmarterContact ──────────────────────────────────────────────────────────
# API key: SmarterContact → Settings → Integrations → API
SMARTER_CONTACT_API_KEY=your_smarter_contact_api_key_here

# The phone number SmarterContact sends outbound messages from (E.164 format)
SMARTER_CONTACT_FROM_NUMBER=+19198001234

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001

# ── Optional: Webhook signature verification ─────────────────────────────────
# If SmarterContact sends a secret header, set it here and validate it in server.js
# WEBHOOK_SECRET=your_webhook_secret
